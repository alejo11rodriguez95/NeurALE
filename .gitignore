# --- Dependencias -----------------------------------------------------------
# Las reinstala `npm install`. Nunca van al repositorio.
node_modules/

# --- Build ------------------------------------------------------------------
# Lo genera Vercel en cada deploy; una copia vieja aquí solo confunde.
dist/
dist-ssr/
*.local

# --- Variables de entorno ---------------------------------------------------
# El repositorio es público: las llaves de Supabase nunca se suben.
# `.env.example` sí se sube (es la plantilla sin valores reales).
.env
.env.*
!.env.example

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cachés de herramientas -------------------------------------------------
.vite/
.cache/
coverage/

# --- Vercel y Supabase CLI --------------------------------------------------
.vercel
.supabase/

# --- Editores ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db

# --- Archivos temporales de Office ------------------------------------------
# Ya pasó una vez: se subió `~$index.ts` de una Edge Function.
~$*
